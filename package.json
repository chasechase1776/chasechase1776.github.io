{
  "name": "bennett-homeschool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "tsc --noEmit && eslint . --max-warnings=0 && prisma generate && next build",
    "smoke:live": "node scripts/smoke-url.mjs https://chasechase1776-github-io.vercel.app",
    "deploy:prod": "vercel --prod",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "ontoly": "ontoly",
    "ontoly:build": "ontoly build . --output .ontoly",
    "ontoly:doctor": "ontoly doctor .",
    "ontoly:summary": "ontoly repository-summary .",
    "ontoly:graph": "ontoly graph . --format html"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.111.0",
    "next": "^15.0.0",
    "pdfkit": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@0xsarwagya/ontoly-cli": "0.1.0-alpha.19",
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "vercel": "^48.0.0"
  }
}
